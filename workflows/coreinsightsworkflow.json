      "parameters": {
        "jsCode": "const rawOutput = $input.item.json.output[0];\nconst parsed = typeof rawOutput === 'string' ? JSON.parse(rawOutput) : rawOutput;\nconst category = parsed.content[0].text.trim();\n\nconst question = $('Edit Fields').item.json.question;\n\nconst prompts = {\n  brand_sentiment: 'You are a consumer research analyst. Focus on consumer perception, sentiment drivers, emotional associations, and brand equity signals.',\n  competitive_intelligence: 'You are a competitive intelligence analyst. Focus on market positioning, differentiation, competitive gaps, and strategic threats.',\n  trend_analysis: 'You are a market trends analyst. Focus on emerging signals, adoption trajectory, timing implications, and forward-looking opportunities.',\n  market_sizing: 'You are a market sizing analyst. Focus on TAM/SAM estimates, growth rates, key segments, and sizing methodology.',\n  general: 'You are a consumer research analyst. Provide a balanced, well-rounded analysis of the research question.'\n};\n\nreturn [{\n  json: {\n    category: category,\n    question: question,\n    category_prompt: prompts[category] || prompts['general']\n  }\n}];"
