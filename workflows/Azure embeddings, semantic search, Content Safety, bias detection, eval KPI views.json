    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.output[0].content[0].text;\nconst parsed = JSON.parse(raw);\n\nconst searchResults = $('Extract Sources').item.json.search_results;\nconst sourceCount = parsed.sources_used ? parsed.sources_used.length : 0;\n\nreturn [{\n  json: {\n    question: $('Extract Sources').item.json.question,\n    category: $('Extract Sources').item.json.category,\n    insight: parsed.insight,\n    recommended_action: parsed.recommended_action,\n    sources_used: parsed.sources_used,\n    source_count: sourceCount,\n    raw_output: raw\n  }\n}];"
