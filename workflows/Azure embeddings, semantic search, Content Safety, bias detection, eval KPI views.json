    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nconst mainItem = allItems.find(item => item.json.embedding) || allItems[0];\nconst semanticItems = allItems.filter(item => item.json.similarity !== undefined);\n\nconst category = mainItem.json.category || 'general';\nconst question = mainItem.json.question;\nconst embedding = mainItem.json.embedding;\n\nconst prompts = {\n  brand_sentiment: 'You are a consumer research analyst. Focus on consumer perception, sentiment drivers, emotional associations, and brand equity signals.',\n  competitive_intelligence: 'You are a competitive intelligence analyst. Focus on market positioning, differentiation, competitive gaps, and strategic threats.',\n  trend_analysis: 'You are a market trends analyst. Focus on emerging signals, adoption trajectory, timing implications, and forward-looking opportunities.',\n  market_sizing: 'You are a market sizing analyst. Focus on TAM/SAM estimates, growth rates, key segments, and sizing methodology.',\n  general: 'You are a consumer research analyst. Provide a balanced, well-rounded analysis of the research question.'\n};\n\nlet fewShotText = '';\nif (semanticItems.length > 0) {\n  fewShotText = '\\n\\nHere are examples of highly rated insights for similar questions:\\n\\n';\n  semanticItems.forEach((ex, i) => {\n    if (ex.json.question) {\n      fewShotText += `Example ${i+1}:\\nQuestion: ${ex.json.question}\\nInsight: ${ex.json.insight}\\nAction: ${ex.json.recommended_action}\\n\\n`;\n    }\n  });\n  fewShotText += 'Match this quality and depth in your response.';\n}\n\nreturn [{\n  json: {\n    category: category,\n    question: question,\n    embedding: embedding,\n    category_prompt: prompts[category] || prompts['general'],\n    few_shot_context: fewShotText\n  }\n}];"
      },
