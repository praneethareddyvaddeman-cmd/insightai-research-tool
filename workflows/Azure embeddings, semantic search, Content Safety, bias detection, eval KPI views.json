    {
      "parameters": {
        "jsCode": "const judgeRaw = $input.item.json.choices[0].message.content;\nconst judgeResult = JSON.parse(judgeRaw);\nconst grounded = judgeResult.grounded;\nconst bias_flagged = judgeResult.bias_flagged || false;\nconst bias_note = judgeResult.bias_note || null;\n\nconst parseOutput = $('Parse Output').item.json;\nconst sourceCount = parseOutput.source_count || 0;\n\nlet confidence;\nif (grounded && sourceCount >= 3) confidence = 'high';\nelse if (grounded && sourceCount >= 1) confidence = 'medium';\nelse confidence = 'low';\n\nreturn [{\n  json: {\n    question: parseOutput.question,\n    category: parseOutput.category,\n    insight: parseOutput.insight,\n    recommended_action: parseOutput.recommended_action,\n    sources_used: parseOutput.sources_used,\n    source_count: sourceCount,\n    grounded: grounded,\n    confidence: confidence,\n    caution: !grounded,\n    caution_message: !grounded ? 'This insight may not be fully grounded in the provided sources. Please verify independently.' : null,\n    bias_flagged: bias_flagged,\n    bias_note: bias_note\n  }\n}];"
      },
