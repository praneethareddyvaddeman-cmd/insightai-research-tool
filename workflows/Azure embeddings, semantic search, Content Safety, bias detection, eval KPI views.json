      "parameters": {
        "jsCode": "const safety = $input.item.json.categoriesAnalysis;\nconst finalOutput = $('Final Output').item.json;\n\nconst isFlagged = safety.some(cat => cat.severity > 2);\nconst flaggedCategories = safety\n  .filter(cat => cat.severity > 2)\n  .map(cat => cat.category);\n\nreturn [{\n  json: {\n    ...finalOutput,\n    safety_flagged: isFlagged,\n    safety_categories: flaggedCategories,\n    safety_scores: safety\n  }\n}];"
