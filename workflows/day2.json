          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "={{ $json.category_prompt }}\n\nYou must base your response ONLY on the sources provided. Do not use prior knowledge.\nReturn ONLY a valid JSON object with exactly these fields:\n- insight: 2-3 sentence summary grounded in the sources\n- recommended_action: one specific actionable recommendation\n- sources_used: array of the source URLs provided\n\nNo markdown, no explanation, just the JSON object."
            },
            {
              "content": "=Research question: {{ $json.question }}\n\nSources:\n{{ $json.search_context }}"
            }
          ]
        },
        "builtInTools": {},
