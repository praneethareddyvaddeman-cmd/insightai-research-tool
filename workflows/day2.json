        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4.1\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI output evaluator. Check if the insight and recommended action are grounded in the sources provided. Return ONLY valid JSON: {\\\"grounded\\\": true/false, \\\"issues\\\": []}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Insight: {{ $json.insight }}\\n\\nRecommended Action: {{ $json.recommended_action }}\\n\\nSources:\\n{{ $json.sources_used.join('\\\\n') }}\"\n    }\n  ],\n  \"max_tokens\": 200\n}",
