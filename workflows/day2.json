    {
      "parameters": {
        "jsCode": "const results = $input.item.json.organic_results || [];\nconst top3 = results.slice(0, 3).map(r => ({\n  title: r.title,\n  snippet: r.snippet,\n  link: r.link\n}));\n\nconst searchContext = top3.map((r, i) => \n  `Source ${i+1}: ${r.title}\\n${r.snippet}\\nURL: ${r.link}`\n).join('\\n\\n');\n\nreturn [{\n  json: {\n    question: $('Build Prompt').item.json.question,\n    category: $('Build Prompt').item.json.category,\n    category_prompt: $('Build Prompt').item.json.category_prompt,\n    search_results: top3,\n    search_context: searchContext\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
